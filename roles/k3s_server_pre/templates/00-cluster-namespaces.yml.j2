---
# Generated by Ansible - do not edit manually
{% for ns_name, ns_meta in k3s_cluster_namespaces.items()  %}
apiVersion: v1
kind: Namespace
metadata:
  name: "{{ ns_name }}"
{% if ns_meta.labels is defined and ns_meta.labels %}
  labels:
  {% for key, val in ns_meta.labels.items() %}
  {{ key }}: "{{ val }}"
  {% endfor %}
{% endif %}
{% if ns_meta.annotations is defined and ns_meta.annotations %}
  annotations:
  {% for key, val in ns_meta.annotations.items() %}
  {{ key }}: "{{ val }}"
  {% endfor %}
{% endif %}

---
{% endfor %}
